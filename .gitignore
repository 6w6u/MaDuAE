# --- Python 核心忽略 ---
__pycache__/          # Python 自动生成的字节码缓存
*.py[cod]             # 编译后的 Python 文件
*$py.class            
*.so                  # C 扩展编译产物
.Python               
build/                # 打包构建目录
develop-eggs/
dist/                 # 发布包目录
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/           # pip 安装时生成的元数据
.installed.cfg
*.egg                 # 打包生成的 egg 文件

# --- 虚拟环境 ---
venv/                 # 常见的虚拟环境目录
ENV/                  
.venv/                
env/                  

# --- 环境变量与敏感信息 (极其重要) ---
.env                  # 存放 API Key、数据库密码等敏感信息的文件
.env.local
.env.*.local

# --- IDE 和编辑器配置 ---
.vscode/              # VS Code 配置
.idea/                # PyCharm/IDEA 配置
*.swp                 # Vim 临时文件
*.swo
*~

# --- Jupyter Notebook 缓存 ---
.ipynb_checkpoints/

# --- 操作系统生成的文件 ---
.DS_Store             # macOS 
Thumbs.db             # Windows